    "icecap": {"patterns": [{"p": "{pre}{mid}氷原"}]},
    "wetland": {"patterns": [{"p": "{pre}{mid}湿原"}]},
    "biome": {"patterns": [{"p": "{pre}{mid}{__species}"}]},
    "province": {
      "patterns": [{"p": "{pre}{mid}", "w": 3}, {"p": "{pre}{mid}郷"}],
      "byTag": {
        "coastal": [{"p": "{pre}浦"}, {"p": "{pre}津"}, {"p": "{pre}浜"}],
        "mountain": [{"p": "{pre}{mid}岳"}, {"p": "{pre}山"}],
        "sea": [{"p": "{pre}{mid}海"}, {"p": "{pre}{mid}灘"}]
      }
    },
    "region": {"patterns": [{"p": "{pre}{mid}"}, {"p": "{pre}{mid}国"}]},
    "spot": {"patterns": [{"p": "{pre}{mid}"}]}
  },
