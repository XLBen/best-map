{
  "id": "ja-kanji",
  "name": "日本·汉字",
  "description": "日式汉字地名：一个写样子、自然的字，加一个写地形的字，再接通称（島、川、湖、岳……）。读音表给出罗马字原文，如“白浜島”→ Shirahamashima。",
  "kind": "template",
  "lists": {
    "pre": [
      "白", "黒", "青", "赤", "金", "大", "小", "高", "長", "若", "古", "新", "松", "竹", "梅", "桜", "藤", "菊", "杉", "柳", "桐",
      "鶴", "亀", "鷹", "鹿", "熊", "月", "日", "星", "雲", "霧", "雪", "風", "春", "秋", "朝", "夕", "北", "南", "東", "西", "中",
      "上", "下", "石", "岩", "水", "神", "龍", "鳥", "花", "美", "安", "福", "豊", "千", "八"
    ],
    "mid": [
      "山", "川", "田", "野", "原", "沢", "谷", "岡", "崎", "浜", "森", "井", "根", "瀬", "戸", "尾", "木", "宮", "浦", "津", "坂",
      "島", "橋", "江", "泉", "峰", "台", "城", "村", "里"
    ]
  },
  "types": {
    "continent": {"patterns": [{"p": "{pre}{mid}大陸"}]},
    "island": {"patterns": [{"p": "{pre}{mid}島", "w": 3}, {"p": "{pre}島"}]},
    "archipelago": {"patterns": [{"p": "{pre}{mid}諸島"}]},
    "peninsula": {"patterns": [{"p": "{pre}{mid}半島"}]},
    "ocean": {"patterns": [{"p": "{pre}{mid}洋"}]},
    "sea": {"patterns": [{"p": "{pre}{mid}海", "w": 2}, {"p": "{pre}{mid}灘"}]},
    "bay": {"patterns": [{"p": "{pre}{mid}湾"}]},
    "strait": {"patterns": [{"p": "{pre}{mid}海峡"}]},
    "lake": {"patterns": [{"p": "{pre}{mid}湖", "w": 3}, {"p": "{pre}{mid}池"}]},
    "river": {"patterns": [{"p": "{pre}{mid}川"}, {"p": "{pre}川"}]},
    "range": {"patterns": [{"p": "{pre}{mid}山脈"}]},
    "peak": {"patterns": [{"p": "{pre}{mid}岳", "w": 2}, {"p": "{pre}山"}]},
    "plateau": {"patterns": [{"p": "{pre}{mid}高原"}]},
    "plain": {"patterns": [{"p": "{pre}{mid}平野"}]},
    "basin": {"patterns": [{"p": "{pre}{mid}盆地"}]},
    "desert": {"patterns": [{"p": "{pre}{mid}砂漠"}]},
