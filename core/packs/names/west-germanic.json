      ["st", 0.8], ["th", 0.5], ["sch", 0.4], ["", 1.5]
    ],
    "nuclei": [["a", 4], ["e", 3], ["i", 3], ["o", 2.5], ["u", 1.5], ["ei", 1], ["au", 0.6]],
    "codas": [
      ["", 6], ["l", 2], ["n", 2], ["r", 2.5], ["s", 0.8], ["t", 0.8], ["d", 0.6], ["m", 0.8], ["ld", 0.4],
      ["nd", 0.4], ["rk", 0.3], ["lm", 0.2]
    ],
    "first": [
      ["k", 3], ["t", 2], ["d", 2], ["b", 2], ["g", 2], ["h", 2], ["l", 1.5], ["m", 2], ["s", 2], ["v", 2],
      ["w", 1.5], ["f", 2], ["br", 1], ["gr", 1], ["fr", 0.7], ["st", 0.8], ["", 1.2]
    ],
    "last": [
      ["", 2], ["l", 2], ["n", 2], ["r", 2.5], ["d", 0.8], ["t", 0.8], ["m", 0.8], ["k", 0.6], ["ld", 0.4],
      ["nd", 0.4]
    ]
  },
  "length": [[1, 3], [2, 5], [3, 1]],
  "lists": {
    "town": ["burg", "dorf", "heim", "stadt", "feld", "hausen", "ingen", ["wik", 0.6], ["holt", 0.6], ["gard", 0.5]],
    "isle": ["ey", "oy", "holm", ["werth", 0.6], ["sand", 0.6]],
