    "island": {"patterns": [{"p": "{pre}{mid}岛", "w": 3}, {"p": "{pre}岛", "w": 0.5}], "byTag": {"volcanic": [{"p": "{pre}{mid}火山岛"}], "small": [{"p": "{pre}岛"}, {"p": "{pre}{mid}礁"}]}},
    "archipelago": {"patterns": [{"p": "{pre}{mid}群岛"}]},
    "peninsula": {"patterns": [{"p": "{pre}{mid}半岛"}]},
