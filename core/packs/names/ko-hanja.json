    "river": {"patterns": [{"p": "{pre}{mid}江", "w": 3}, {"p": "{pre}{mid}川", "w": 2}, {"p": "{pre}江"}], "byTag": {"big": [{"p": "{pre}江"}, {"p": "{pre}{mid}江"}], "small": [{"p": "{pre}{mid}川"}, {"p": "{pre}溪"}]}},
    "range": {"patterns": [{"p": "{pre}{mid}山脉"}]},
    "peak": {"patterns": [{"p": "{pre}{mid}山", "w": 3}, {"p": "{pre}{mid}峰"}, {"p": "{pre}岳山"}], "byTag": {"volcanic": [{"p": "{pre}{mid}火山"}]}},
    "plateau": {"patterns": [{"p": "{pre}{mid}高原"}]},
    "plain": {"patterns": [{"p": "{pre}{mid}平野"}, {"p": "{pre}{mid}平原"}]},
    "basin": {"patterns": [{"p": "{pre}{mid}盆地"}]},
    "desert": {"patterns": [{"p": "{pre}{mid}沙漠"}]},
    "forest": {"patterns": [{"p": "{pre}{mid}林", "w": 2}, {"p": "{pre}{mid}森林"}]},
    "tundra": {"patterns": [{"p": "{pre}{mid}冻原"}]},
    "icecap": {"patterns": [{"p": "{pre}{mid}冰原"}]},
    "wetland": {"patterns": [{"p": "{pre}{mid}湿地"}]},
    "biome": {"patterns": [{"p": "{pre}{mid}{__species}"}]},
    "province": {"patterns": [{"p": "{pre}{mid}", "w": 3}, {"p": "{pre}{mid}道"}, {"p": "{pre}{mid}郡"}, {"p": "{pre}{mid}邑"}], "byTag": {"coastal": [{"p": "{pre}浦"}, {"p": "{pre}津"}, {"p": "{pre}{mid}浦"}], "river": [{"p": "{pre}川"}, {"p": "{pre}{mid}津"}], "mountain": [{"p": "{pre}{mid}岭"}, {"p": "{pre}山"}], "sea": [{"p": "{pre}{mid}海"}], "waste": [{"p": "{pre}{mid}荒原"}]}},
    "region": {"patterns": [{"p": "{pre}{mid}道", "w": 2}, {"p": "{pre}{mid}"}, {"p": "{pre}{mid}地方"}]},
    "spot": {"patterns": [{"p": "{pre}{mid}", "w": 2}], "byTag": {"coastal": [{"p": "{pre}{mid}岬"}], "river": [{"p": "{pre}{mid}渡"}], "mountain": [{"p": "{pre}{mid}岭"}], "sea": [{"p": "{pre}{mid}礁"}]}}
