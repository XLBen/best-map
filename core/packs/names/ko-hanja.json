    "pre": ["白", "青", "赤", "金", "大", "小", "高", "长", "古", "新", "松", "竹", "梅", "桃", "莲", "菊", "鹤", "龟", "凤", "龙", "虎", "鹿", "月", "日", "星", "云", "雪", "风", "春", "秋", "东", "西", "南", "北", "中", "上", "下", "石", "玉", "水", "清", "光", "安", "平", "永", "福", "庆", "全", "忠", "天", "仁", "文", "丰", "泰", "华", "汉", "明", "万", "千", "三", "宝", "兴", "昌", "顺", "德", "善", "吉", "晋", "济", "礼", "雅", "草", "花", "银", "铁", "孤", "雉"],
